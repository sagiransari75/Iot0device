datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js" // Yahan pehle galti thi, "js" hona chahiye
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String?
  email        String   @unique
  passwordHash String
  role         String   @default("user")
  createdAt    DateTime @default(now())
  updatedAt    DateTime?

  circuits     Circuit[]
  history      UserHistory[]
}

model Circuit {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  data      Json     // Isme board positions, sensors, aur wires ka data rahega
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id]) // Link to User
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// User kya kya kar raha hai uska record rakhne ke liye
model UserHistory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  action    String   // e.g., "Added DHT11", "Connected Pin 7"
  details   String?  // Extra info agar chahiye toh
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}